{% doc %}
  @prompt
    Eyewear 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-eyewear-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-eyewear__card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    min-height: 280px;
    display: flex;
    align-items: flex-end;
    background: #111111;
    color: #ffffff;
  }

  .ai-eyewear__image-{{ ai_gen_id }},
  .ai-eyewear__placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-eyewear__image-{{ ai_gen_id }} {
    object-fit: cover;
  }

  .ai-eyewear__placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e9e9e9;
    color: #333333;
  }

  .ai-eyewear__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 420px;
    max-height: 420px;
  }

  .ai-eyewear__overlay-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 32px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.82) 100%);
  }

  .ai-eyewear__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 8px;
    color: #ffd502;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ai-eyewear__title-{{ ai_gen_id }} {
    margin: 0 0 8px;
    color: #ffffff;
    font-size: 32px;
    line-height: 1.1;
  }

  .ai-eyewear__text-{{ ai_gen_id }} {
    max-width: 520px;
    margin: 0 0 20px;
    color: #ffffff;
    font-size: 16px;
    line-height: 1.5;
  }

  .ai-eyewear__link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 22px;
    background: #ffd502;
    color: #000000;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ai-eyewear__link-{{ ai_gen_id }}:hover,
  .ai-eyewear__link-{{ ai_gen_id }}:focus-visible {
    background: #ffffff;
    color: #000000;
  }

  .ai-eyewear__link-{{ ai_gen_id }}:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-eyewear__card-{{ ai_gen_id }} {
      min-height: 360px;
    }

    .ai-eyewear__overlay-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-eyewear__title-{{ ai_gen_id }} {
      font-size: 27px;
    }
  }
{% endstyle %}

{% assign eyewear_url = block.settings.link %}
{% if block.settings.collection != blank %}
  {% assign eyewear_url = block.settings.collection.url %}
{% endif %}

<div class="ai-eyewear-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-eyewear__card-{{ ai_gen_id }}">
    {% if block.settings.image != blank %}
      <img
        class="ai-eyewear__image-{{ ai_gen_id }}"
        src="{{ block.settings.image | image_url: width: 1600 }}"
        alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
      >
    {% else %}
      <div class="ai-eyewear__placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}

    <div class="ai-eyewear__overlay-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-eyewear__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="ai-eyewear__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% if block.settings.description != blank %}
        <div class="ai-eyewear__text-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
      {% if eyewear_url != blank %}
        <a class="ai-eyewear__link-{{ ai_gen_id }}" href="{{ eyewear_url }}">
          {{ block.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Eyewear feature",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Exact Archery"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Eyewear"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Shop dependable eyewear built for clear vision and confident performance."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop eyewear"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Eyewear collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Fallback link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Eyewear feature"
    }
  ],
  "tag": null,
  "class": "eyewear-feature-block"
}
{% endschema %}